# Copy to .env.local and fill in (from Supabase: Project Settings -> API Keys).
# Without these the app still runs, saving only to the local database.

# Public: bundled into the app.
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Private: only for admin scripts on your computer. Never prefix with VITE_.
SUPABASE_PROJECT_ID=
SUPABASE_SECRET_KEY=
SUPABASE_DB_PASSWORD=
